<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_menu_themed"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/settings_padding">

        <TextView
            style="@style/GameTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/settings"
            android:textSize="@dimen/settings_title_text" />

        <!-- ===== ภาษา ===== -->
        <TextView
            style="@style/GameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/settings_first_section_gap"
            android:text="@string/language"
            android:textSize="@dimen/settings_label_text" />

        <LinearLayout
            android:layout_width="@dimen/settings_row_width"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/settings_label_gap"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnThai"
                style="@style/GameButton.Blue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/settings_button_gap"
                android:layout_weight="1"
                android:text="@string/lang_thai" />

            <Button
                android:id="@+id/btnEnglish"
                style="@style/GameButton.Blue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/settings_button_gap"
                android:layout_weight="1"
                android:text="@string/lang_english" />
        </LinearLayout>

        <!-- ===== ธีม ===== -->
        <TextView
            style="@style/GameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/settings_section_gap"
            android:text="@string/theme"
            android:textSize="@dimen/settings_label_text" />

        <LinearLayout
            android:layout_width="@dimen/settings_row_width"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/settings_label_gap"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnDay"
                style="@style/GameButton.Blue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/settings_button_gap"
                android:layout_weight="1"
                android:text="@string/theme_day" />

            <Button
                android:id="@+id/btnNight"
                style="@style/GameButton.Blue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/settings_button_gap"
                android:layout_weight="1"
                android:text="@string/theme_night" />
        </LinearLayout>

        <Button
            android:id="@+id/btnBack"
            style="@style/GameButton.Red"
            android:layout_width="@dimen/settings_back_width"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/settings_back_gap"
            android:text="@string/back" />
    </LinearLayout>
</ScrollView>