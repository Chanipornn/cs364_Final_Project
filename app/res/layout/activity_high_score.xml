<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_menu"
        android:foreground="@color/menu_overlay" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/menu_padding">

        <TextView
            style="@style/GameTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/high_score"
            android:textSize="@dimen/menu_title_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="🏆"
            android:textSize="48sp" />

        <TextView
            android:id="@+id/highScoreText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="0"
            android:textColor="#4A4A4A"
            android:textSize="48sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnClearHighScore"
            style="@style/GameButton.Orange"
            android:layout_width="@dimen/menu_button_width"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="@dimen/menu_button_gap"
            android:text="@string/clear_high_score" />

        <Button
            android:id="@+id/btnBack"
            style="@style/GameButton.Blue"
            android:layout_width="@dimen/menu_button_width"
            android:layout_height="wrap_content"
            android:text="@string/back" />

    </LinearLayout>

</FrameLayout>