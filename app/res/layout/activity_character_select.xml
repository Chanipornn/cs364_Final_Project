<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_menu_themed"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/char_padding">

        <TextView
            style="@style/GameTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/select_character"
            android:textSize="@dimen/char_title_text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/char_row_margin_top"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPrev"
                style="@style/GameButton.Blue"
                android:layout_width="@dimen/char_arrow_size"
                android:layout_height="@dimen/char_arrow_size"
                android:paddingLeft="0dp"
                android:paddingRight="0dp"
                android:text="&lt;"
                android:textSize="@dimen/char_arrow_text" />

            <ImageView
                android:id="@+id/imgPreview"
                android:layout_width="0dp"
                android:layout_height="@dimen/char_preview_height"
                android:layout_weight="1"
                android:contentDescription="@string/select_character"
                android:scaleType="fitCenter" />

            <Button
                android:id="@+id/btnNext"
                style="@style/GameButton.Blue"
                android:layout_width="@dimen/char_arrow_size"
                android:layout_height="@dimen/char_arrow_size"
                android:paddingLeft="0dp"
                android:paddingRight="0dp"
                android:text="&gt;"
                android:textSize="@dimen/char_arrow_text" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtName"
            style="@style/GameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/char_name_margin_top"
            android:textSize="@dimen/char_name_text" />

        <Button
            android:id="@+id/btnSelect"
            style="@style/GameButton.Green"
            android:layout_width="@dimen/char_button_width"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/char_select_margin_top"
            android:text="@string/select" />

        <Button
            android:id="@+id/btnBack"
            style="@style/GameButton.Red"
            android:layout_width="@dimen/char_button_width"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/char_back_margin_top"
            android:text="@string/back" />
    </LinearLayout>
</ScrollView>