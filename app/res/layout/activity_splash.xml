<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_menu" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:shadowColor="#80000000"
            android:shadowDx="4"
            android:shadowDy="4"
            android:shadowRadius="6"
            android:text="@string/app_name"
            android:textColor="#FFFFFF"
            android:textSize="44sp"
            android:textStyle="bold" />

        <!-- แสดงตัวละครที่เลือกอยู่ -->
        <ImageView
            android:id="@+id/imgMenuBird"
            android:layout_width="120dp"
            android:layout_height="90dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:contentDescription="@string/select_character"
            android:scaleType="fitCenter" />

        <Button
            android:id="@+id/playButton"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:text="@string/play_game" />

        <Button
            android:id="@+id/btnCharacter"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:text="@string/select_character" />

        <!-- ปุ่ม High Score / Settings / Exit ให้คนที่ 2 และ 3 เพิ่มตรงนี้ -->
    </LinearLayout>
</FrameLayout>
