<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_menu"
        android:foreground="@color/menu_overlay" />

    <!-- ScrollView: จอเตี้ยหรือผู้ใช้ตั้งตัวอักษรใหญ่ ปุ่มจะเลื่อนดูได้ ไม่ล้นจอ
         fillViewport: จอปกติยังจัดกึ่งกลางเหมือนเดิม -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/menu_padding">

            <TextView
                style="@style/GameTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/app_name"
                android:textSize="@dimen/menu_title_text" />

            <!-- แสดงตัวละครที่เลือกอยู่ -->
            <ImageView
                android:id="@+id/imgMenuBird"
                android:layout_width="@dimen/menu_bird_width"
                android:layout_height="@dimen/menu_bird_height"
                android:layout_marginTop="@dimen/menu_bird_margin_top"
                android:layout_marginBottom="@dimen/menu_bird_margin_bottom"
                android:contentDescription="@string/select_character"
                android:scaleType="fitCenter" />

            <Button
                android:id="@+id/playButton"
                style="@style/GameButton.Green"
                android:layout_width="@dimen/menu_button_width"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/menu_button_gap"
                android:text="@string/play_game"
                android:textSize="@dimen/menu_play_text" />

            <Button
                android:id="@+id/btnCharacter"
                style="@style/GameButton.Orange"
                android:layout_width="@dimen/menu_button_width"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/menu_button_gap"
                android:text="@string/select_character" />

            <Button
                android:id="@+id/btnSettings"
                style="@style/GameButton.Blue"
                android:layout_width="@dimen/menu_button_width"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/menu_button_gap"
                android:text="@string/settings" />

            <!-- ปุ่ม High Score / Exit ให้คนที่ 3 เพิ่มตรงนี้
                 แนะนำ: High Score = GameButton.Blue, Exit/Clear = GameButton.Red
                 ความกว้าง/ระยะห่างใช้ @dimen/menu_button_width และ @dimen/menu_button_gap -->
        </LinearLayout>
    </ScrollView>
</FrameLayout>