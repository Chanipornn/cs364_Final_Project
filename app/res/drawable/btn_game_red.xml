<?xml version="1.0" encoding="utf-8"?>
<!-- ปุ่มเกมสีred: หน้าปุ่มไล่สี + ขอบหนา + แถบเงาด้านล่าง กดแล้วปุ่มยุบลง -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ตอนกด: หน้าปุ่มเลื่อนลง ไม่เห็นแถบเงา -->
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="6dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:endColor="#F0453A" android:startColor="#BF2A20" />
                    <corners android:radius="18dp" />
                    <stroke android:width="3dp" android:color="#7A1710" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- ปกติ -->
    <item>
        <layer-list>
            <!-- แถบเงา (ความหนาปุ่ม) -->
            <item android:top="6dp">
                <shape android:shape="rectangle">
                    <solid android:color="#BF2A20" />
                    <corners android:radius="18dp" />
                    <stroke android:width="3dp" android:color="#7A1710" />
                </shape>
            </item>
            <!-- หน้าปุ่ม -->
            <item android:bottom="6dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:endColor="#F0453A" android:startColor="#FF8A80" />
                    <corners android:radius="18dp" />
                    <stroke android:width="3dp" android:color="#7A1710" />
                </shape>
            </item>
            <!-- แถบเงาสะท้อนด้านบน -->
            <item android:left="14dp" android:right="14dp" android:top="6dp" android:height="6dp" android:gravity="top">
                <shape android:shape="rectangle">
                    <solid android:color="#66FFFFFF" />
                    <corners android:radius="3dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
