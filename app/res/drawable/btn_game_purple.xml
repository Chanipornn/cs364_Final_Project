<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ตอนกด -->
    <item android:state_pressed="true">
        <layer-list>

            <item android:top="6dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#7A3DB8"
                        android:endColor="#9B5DE5" />

                    <corners android:radius="18dp" />

                    <stroke
                        android:width="3dp"
                        android:color="#5B2A86" />
                </shape>
            </item>

        </layer-list>
    </item>


    <!-- ปกติ -->
    <item>
        <layer-list>

            <!-- แถบเงาด้านล่าง -->
            <item android:top="6dp">
                <shape android:shape="rectangle">

                    <solid android:color="#7A3DB8" />

                    <corners android:radius="18dp" />

                    <stroke
                        android:width="3dp"
                        android:color="#5B2A86" />

                </shape>
            </item>


            <!-- หน้าปุ่ม -->
            <item android:bottom="6dp">
                <shape android:shape="rectangle">

                    <gradient
                        android:angle="270"
                        android:startColor="#C084FC"
                        android:endColor="#9B5DE5" />

                    <corners android:radius="18dp" />

                    <stroke
                        android:width="3dp"
                        android:color="#5B2A86" />

                </shape>
            </item>


            <!-- แถบเงาสะท้อนด้านบน -->
            <item
                android:left="14dp"
                android:right="14dp"
                android:top="6dp"
                android:height="6dp"
                android:gravity="top">

                <shape android:shape="rectangle">

                    <solid android:color="#66FFFFFF" />

                    <corners android:radius="3dp" />

                </shape>

            </item>

        </layer-list>
    </item>

</selector>